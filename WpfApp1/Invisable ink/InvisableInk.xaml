<Window x:Class="VirtualOS.Invisable_ink.InvisableInk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualOS.Invisable_ink"
        mc:Ignorable="d"
        Title="InvisableInk" Height="350" Width="525">
    <Grid>
        <TextBox Name="ChatBox" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="10,70,10,80"/>
        <!-- footer controls -->
        <TextBox Name="MessageBox" Height="30" Margin="10,0,160,30" VerticalAlignment="Bottom"/>
        <Button Name="SendButton" Content="Send" Width="70" Height="30" Margin="0,0,85,30" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="SendButton_Click"/>
        <Button x:Name="SendButton_Copy" Content="Send File" Width="70" Height="30" Margin="0,0,10,30" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="SendButton_Click"/>
        <!-- contact with.. -->
        <TextBox Name="UserTextbox" HorizontalAlignment="Left" Margin="108,13,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="Change_Peer"/>
        <Label Content="User:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Button Content="Contact" HorizontalAlignment="Left" Height="23" Margin="244,10,0,0" VerticalAlignment="Top" Width="79" Click="Contact_Click"/>
        <!-- ur usr name -->
        <TextBox x:Name="YourUserNameTextBox" HorizontalAlignment="Left" Margin="108,42,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Your Username:" HorizontalAlignment="Left" Margin="10,38,0,0" VerticalAlignment="Top"/>
        <Button Content="Change" HorizontalAlignment="Left" Height="24" Margin="244,39,0,0" VerticalAlignment="Top" Width="79" Click="ChangeB_Click"/>
        
    </Grid>
</Window>
