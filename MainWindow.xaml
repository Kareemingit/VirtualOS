<Window x:Class="VirtualOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Desktop"
        Height="720" Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Black"
        WindowStyle="None">

    <Grid>
        <!-- Wallpaper Layer -->
        <Image x:Name="Wallpaper"
               Stretch="Fill"
               Panel.ZIndex="0" />

        <!-- Desktop Icon Layer -->
        <Canvas x:Name="DesktopCanvas"
                Background="Transparent"
                MouseRightButtonUp="DesktopCanvas_RightClick"
                Panel.ZIndex="0">
        </Canvas>

        <DockPanel VerticalAlignment="Bottom"
                   Height="30"
                   Background="#222"
                   Panel.ZIndex="99">
            
            <Button Content="Start"
                    Width="80"
                    Margin="4,0"
                    Click="StartMenu_Click"
                    HorizontalAlignment="Left"/>
        </DockPanel>
    </Grid>
</Window>